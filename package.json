{
  "name": "law-mate",
  "private": true,
  "version": "1.12.7",
  "type": "module",
  "description": "LawMate - Keep Your Notes about Law Sections Organized.",
  "author": {
    "name": "Nazmul Hassan",
    "email": "nazmulnhb@gmail.com",
    "url": "https://nazmul-nhb.vercel.app"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "vite:clean": "rm -rf node_modules/.vite && rm -rf node_modules/.vite-temp",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --diagnostic-level=warn",
    "fix": "biome check --write --diagnostic-level=warn",
    "format": "biome format --write --diagnostic-level=warn",
    "fixmat": "biome check --write --diagnostic-level=info && biome format --write --diagnostic-level=info",
    "migrate": "biome migrate --write",
    "commit": "nhb-commit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "i18next": "^26.3.6",
    "locality-idb": "^2.5.0",
    "lucide-react": "^1.26.0",
    "nhb-hooks": "^1.50.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.14.0",
    "tailwind-merge": "^3.6.0",
    "toolbox-x": "^2.6.16",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.5",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "nhb-scripts": "^1.9.2",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5"
  }
}
